# App
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
CORS_ORIGIN=*

# Postgres
POSTGRES_USER=sandbox
POSTGRES_PASSWORD=sandbox
POSTGRES_DB=sandbox_api
POSTGRES_PORT=5432

# String de conexão usada pela API quando rodando FORA do docker-compose (ex.: `npm run dev` no
# host, com só `docker compose up postgres`). Dentro do compose, o serviço `api` ignora este valor
# e usa "postgres" como host (nome do serviço na rede do compose) em vez de "localhost"
DATABASE_URL=postgres://giftme:giftme@localhost:5432/giftme_api
